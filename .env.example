# AI: "openai" or "grok"
AI_PROVIDER=openai
OPENAI_API_KEY=
XAI_API_KEY=
# optional model override (defaults: gpt-4o-mini / grok-3-mini)
AI_MODEL=

# QuickCommerceAPI (quickcommerceapi.com) - key from their dashboard
QC_API_KEY=
# Shopper location (default Bengaluru). Each search costs 1 credit per platform.
QC_LAT=12.9021
QC_LON=77.6639
QC_PLATFORMS=BlinkIt,Zepto,Swiggy
# Needed only if QC_PLATFORMS includes DMart, JioMart or Minutes
QC_PINCODE=

# Supabase (use the service_role key; it stays on the server)
SUPABASE_URL=
SUPABASE_KEY=
